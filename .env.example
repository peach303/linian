# ── 应用 ──
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
PORT=3001

# 访问密码（可选）：设了以后页面和 API 都要登录（浏览器自带的 Basic Auth）。
# 只在你自己电脑上用可以不设；要部署到公网（Render / 云服务器）一定要设。
APP_PASSWORD=

# ── 数据库 ──
DATABASE_URL=postgresql://linian:linian@localhost:5432/linian?schema=public

# ── Redis（BullMQ：回复延迟 / 主动消息 / 冷却）──
REDIS_URL=redis://localhost:6379

# ── 对象存储 ──
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=linian
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# ── LLM（字卡拼接 / 自由组句 / 拼音 / 歌词 / 情绪）──
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── MiniMax 语音（也可以不填这里：设置 → 接入 里填的优先）──
# 说明：MINIMAX_API_KEY / MINIMAX_GROUP_ID 两把都要；MINIMAX_MODEL 默认 speech-02-hd，
#       MINIMAX_VOICE_ID 留空则用 male-qn-qingse（接入页能试听换音色）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-02-hd
MINIMAX_VOICE_ID=

# ── 联网搜索推送 ──
SEARCH_PROVIDER=none            # none | bing | serpapi | rss
SEARCH_API_KEY=

# ── 加密（用于加密集成 Key）──
SECRET_ENC_KEY=please-change-me-32bytes-secret!
