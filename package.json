{
  "name": "linian",
  "private": true,
  "version": "0.1.0",
  "description": "黎念 LiNian — 字卡传讯 & 梦角陪伴",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @linian/web",
    "dev:api": "node apps/server/dev-server.mjs",
    "start": "node apps/server/dev-server.mjs",
    "dev:server": "npm run dev -w @linian/server",
    "build": "npm run build -w @linian/shared && npm run build -w @linian/web && npm run build -w @linian/server",
    "build:web": "npm run build -w @linian/web",
    "icons": "node apps/web/scripts/make-icons.mjs",
    "font": "node apps/web/scripts/fetch-hand-font.mjs",
    "pack:public": "node scripts/make-public-copy.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
